    <script>
        const API_URL = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vRAy0cnPqv6k1ckLp9wp9fRwh3kiMxZEHkEKTzPfDOKXOdfbxS3TdCWXzJZVTKydHUBEenaeUBYJsst/pub?output=csv';
        const JSON_URL = 'mcq.json';

        // Master Set Configurations — now with three entries
        let setsData = [
            { id: 'csv', title: 'Book MCQs', desc: 'Fetched live from Google Sheets', data: [] },
            { id: 'json', title: 'Additional Syllabus MCQs', desc: 'Official JSON modules', data: [] },
            { id: 'summary', title: 'Repeated Questions Summary', desc: 'Quick revision of repeated topics', data: [] }   // <-- NEW
        ];

        // Global State Variables
        let currentSetIndex = 0;
        let currentQIndex = 0;
        let currentMode = 'practice'; // 'practice' or 'study'
        let sessionState = []; 
        let bookmarked = new Set();
        let stats = { correct: 0, wrong: 0 };
        let timerInterval;
        let timeRemaining = 120 * 60; // 120 minutes
        let isTestActive = false;
        let soundEnabled = true;

        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        function playBeep(freq, type, duration) {
            if (!soundEnabled) return;
            if (audioCtx.state === 'suspended') audioCtx.resume();
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = type;
            osc.frequency.value = freq;
            gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + duration);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + duration);
        }
        function soundCorrect() { playBeep(600, 'triangle', 0.12); setTimeout(() => playBeep(800, 'triangle', 0.18), 80); }
        function soundWrong() { playBeep(250, 'sawtooth', 0.18); setTimeout(() => playBeep(200, 'sawtooth', 0.25), 120); }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            const icon = document.getElementById('sound-icon');
            if (soundEnabled) {
                icon.className = 'fa-solid fa-volume-high';
                showToast('Sound ON');
            } else {
                icon.className = 'fa-solid fa-volume-xmark';
                showToast('Sound OFF');
            }
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.classList.add('show');
            clearTimeout(toast._timeout);
            toast._timeout = setTimeout(() => toast.classList.remove('show'), 2000);
        }

        function showDialog(title, message, type = 'alert', onConfirm = null) {
            const overlay = document.getElementById('custom-dialog-overlay');
            document.getElementById('dialog-title').innerText = title;
            document.getElementById('dialog-message').innerText = message;
            
            const btnContainer = document.getElementById('dialog-buttons');
            btnContainer.innerHTML = '';
            
            if (type === 'confirm') {
                const cancelBtn = document.createElement('button');
                cancelBtn.className = 'px-4 py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-white text-sm font-bold flex-1 touch-manipulation';
                cancelBtn.innerText = 'Cancel';
                cancelBtn.onclick = () => overlay.classList.remove('active');
                btnContainer.appendChild(cancelBtn);
            }
            
            const okBtn = document.createElement('button');
            okBtn.className = 'px-4 py-2 rounded-lg bg-blue-600 hover:bg-blue-500 text-white text-sm font-bold flex-1 shadow-lg touch-manipulation';
            okBtn.innerText = type === 'confirm' ? 'Confirm' : 'OK';
            okBtn.onclick = () => {
                overlay.classList.remove('active');
                if (onConfirm) onConfirm();
            };
            btnContainer.appendChild(okBtn);
            overlay.classList.add('active');
        }

        // CSV Parser
        function parseCSV(text) {
            const rows = text.split('\n').map(row => row.trim()).filter(row => row);
            const headers = rows[0].split(',').map(h => h.trim());
            const result = [];
            
            for (let i = 1; i < rows.length; i++) {
                const values = rows[i].match(/(?:\"([^\"]*(?:\"\"[^\"]*)*)\"|([^,]+))/g) || [];
                const record = {};
                for (let j = 0; j < headers.length; j++) {
                    let val = values[j] ? values[j].trim() : "";
                    if (val.startsWith('"') && val.endsWith('"')) {
                        val = val.substring(1, val.length - 1).replace(/""/g, '"');
                    }
                    record[headers[j]] = val;
                }
                result.push(record);
            }
            return result;
        }

        function normalizeCSV(rows) {
            return rows.map(r => {
                let ans = String(r['Correct Answer'] || '').trim().toUpperCase();
                let cIndex = ans.includes('A') ? 0 : ans.includes('B') ? 1 : ans.includes('C') ? 2 : ans.includes('D') ? 3 : 0;
                return {
                    question: r['Question'],
                    options: [r['Option A'], r['Option B'], r['Option C'], r['Option D']],
                    correctOption: cIndex,
                    explanation: r['Explanation'] || "Explanation not provided in source."
                };
            }).filter(q => q.question);
        }

        function normalizeJSON(data) {
            return data.map(item => {
                if(!item.question) return null;
                let ansStr = String(item.answer || '').toLowerCase();
                let cIndex = ansStr.startsWith('a') ? 0 : ansStr.startsWith('b') ? 1 : ansStr.startsWith('c') ? 2 : ansStr.startsWith('d') ? 3 : 0;
                return {
                    question: item.question,
                    options: [
                        item.options?.a || "Option A", 
                        item.options?.b || "Option B", 
                        item.options?.c || "Option C", 
                        item.options?.d || "Option D"
                    ],
                    correctOption: cIndex,
                    explanation: item.explanation || "No explanation provided."
                };
            }).filter(q => q !== null);
        }

        async function fetchAllData() {
            document.getElementById('loading-indicator').classList.remove('hidden');
            
            // 1. Fetch CSV
            try {
                const csvRes = await fetch(API_URL);
                if (csvRes.ok) {
                    const csvText = await csvRes.text();
                    setsData[0].data = normalizeCSV(parseCSV(csvText));
                }
            } catch(e) { console.warn("CSV fetch failed, using fallback.", e); }

            // 2. Fetch JSON
            try {
                if (window.location.protocol === 'blob:' || window.location.protocol === 'data:' || window.location.protocol === 'about:') {
                    throw new Error("Relative fetch not supported in preview environments.");
                }
                const jsonRes = await fetch(JSON_URL);
                if (jsonRes.ok) {
                    const jsonData = await jsonRes.json();
                    setsData[1].data = normalizeJSON(jsonData);
                }
            } catch(e) { 
                console.log("Using fallback data for Additional Syllabus MCQs."); 
                setsData[1].data = [
                    {
                        question: "What is the primary focus of forensic accounting?",
                        options: ["Preparing financial statements", "Examining accounting records for potential crimes", "Tax planning", "Auditing"],
                        correctOption: 1,
                        explanation: "Forensic accounting involves investigating records for potential financial crimes."
                    },
                    {
                        question: "Which of the following is NOT a phase of the standard audit process?",
                        options: ["Planning", "Execution", "Marketing", "Reporting"],
                        correctOption: 2,
                        explanation: "Marketing is not a part of the standard financial audit process."
                    }
                ];
            }

            // Fallback for CSV if network blocked
            if (setsData[0].data.length === 0) {
                 setsData[0].data = [
                     {
                        question: "Under the Income Tax Act, 1961, which section deals with the deduction for life insurance premia?",
                        options: ["Section 80C", "Section 80D", "Section 80G", "Section 80TTA"],
                        correctOption: 0,
                        explanation: "Section 80C provides deductions for specified investments like LIC, PPF, etc."
                     }
                 ];
            }
            
            // Summary set has no data — it's a viewer
            document.getElementById('loading-indicator').classList.add('hidden');
        }

        const DB_NAME = "CA_AITT_DB";
        const DB_VERSION = 1;
        
        function openDB() {
            return new Promise((resolve, reject) => {
                const req = indexedDB.open(DB_NAME, DB_VERSION);
                req.onupgradeneeded = (e) => {
                    const db = e.target.result;
                    if (!db.objectStoreNames.contains('progress')) db.createObjectStore('progress'); 
                    if (!db.objectStoreNames.contains('history')) db.createObjectStore('history', { autoIncrement: true });
                };
                req.onsuccess = () => resolve(req.result);
                req.onerror = () => reject(req.error);
            });
        }
        
        async function idbSet(storeName, key, val) {
            const db = await openDB();
            return new Promise((resolve, reject) => {
                const tx = db.transaction(storeName, 'readwrite');
                tx.objectStore(storeName).put(val, key);
                tx.oncomplete = () => resolve();
                tx.onerror = () => reject(tx.error);
            });
        }
        
        async function idbGet(storeName, key) {
            const db = await openDB();
            return new Promise((resolve, reject) => {
                const req = db.transaction(storeName, 'readonly').objectStore(storeName).get(key);
                req.onsuccess = () => resolve(req.result);
                req.onerror = () => reject(req.error);
            });
        }

        async function idbAddHistory(record) {
            const db = await openDB();
            return new Promise((resolve, reject) => {
                const tx = db.transaction('history', 'readwrite');
                tx.objectStore('history').add(record);
                tx.oncomplete = () => resolve();
                tx.onerror = () => reject(tx.error);
            });
        }

        async function idbGetAllHistory() {
            const db = await openDB();
            return new Promise((resolve, reject) => {
                const req = db.transaction('history', 'readonly').objectStore('history').getAll();
                req.onsuccess = () => resolve(req.result || []);
                req.onerror = () => reject(req.error);
            });
        }

        async function idbClearAll() {
            const db = await openDB();
            return new Promise((resolve, reject) => {
                const tx = db.transaction(['progress', 'history'], 'readwrite');
                tx.objectStore('progress').clear();
                tx.objectStore('history').clear();
                tx.oncomplete = () => resolve();
                tx.onerror = () => reject(tx.error);
            });
        }

        async function initApp() {
            await fetchAllData();
            renderSetCards();
            showView('sets');
            const savedState = await idbGet('progress', 'current');
            if (savedState && savedState.isTestActive) {
                showDialog('Resume Session', `You have an active ${savedState.mode} session on ${setsData[savedState.setIndex].title}. Continue?`, 'confirm', () => {
                    resumeSession(savedState);
                });
            }
            window.summaryLoaded = false;
        }

        function showView(viewId) {
            if (isTestActive && viewId !== 'quiz') {
                showDialog('Leave Session?', 'Your test is active. Exiting will pause the test, but you can resume it from the Dashboard.', 'confirm', () => {
                    pauseSession();
                    executeShowView(viewId);
                });
                return;
            }
            executeShowView(viewId);
        }

        function executeShowView(viewId) {
            ['view-sets', 'view-analytics', 'view-rules', 'view-quiz', 'view-summary'].forEach(id => {
                document.getElementById(id).classList.add('hidden');
                document.getElementById(id).classList.remove('flex');
            });
            document.getElementById(`view-${viewId}`).classList.remove('hidden');
            document.getElementById(`view-${viewId}`).classList.add('flex');
            
            if (viewId === 'quiz') {
                document.getElementById('main-tabs').classList.add('hidden');
                document.getElementById('quiz-footer').classList.remove('hidden');
                document.getElementById('quiz-footer').classList.add('mobile-sticky-footer');
            } else {
                document.getElementById('main-tabs').classList.remove('hidden');
                document.getElementById('quiz-footer').classList.add('hidden');
                document.getElementById('quiz-footer').classList.remove('mobile-sticky-footer');
                document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                const activeTab = document.querySelector(`[data-tab="${viewId}"]`);
                if(activeTab) activeTab.classList.add('active');
            }
            
            if (viewId === 'analytics') renderAnalytics();
            if (viewId === 'summary') loadSummary();
            window.scrollTo(0,0);
        }

        function requestHome() {
            if (isTestActive) {
                showDialog('Warning', 'Exiting now will pause your session.', 'confirm', () => {
                    pauseSession();
                    executeShowView('sets');
                });
            } else {
                executeShowView('sets');
            }
        }

        // ─── Summary Loader ───
        async function loadSummary() {
            const loading = document.getElementById('summary-loading');
            const error = document.getElementById('summary-error');
            const body = document.getElementById('summary-body');
            
            if (window.summaryLoaded) {
                loading.classList.add('hidden');
                error.classList.add('hidden');
                body.classList.remove('hidden');
                return;
            }
            
            loading.classList.remove('hidden');
            error.classList.add('hidden');
            body.classList.add('hidden');
            
            try {
                const response = await fetch('Repeated.html');
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                const html = await response.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const bodyContent = doc.body;
                bodyContent.querySelectorAll('script').forEach(s => s.remove());
                body.innerHTML = bodyContent.innerHTML;
                window.summaryLoaded = true;
                loading.classList.add('hidden');
                body.classList.remove('hidden');
            } catch (err) {
                console.warn('Summary load error:', err);
                loading.classList.add('hidden');
                error.classList.remove('hidden');
            }
        }

        async function renderSetCards() {
            const grid = document.getElementById('set-cards-grid');
            grid.innerHTML = '';
            const history = await idbGetAllHistory();
            const savedState = await idbGet('progress', 'current');

            setsData.forEach((set, idx) => {
                // Special handling for the summary card
                if (set.id === 'summary') {
                    grid.innerHTML += `
                        <div class="set-card flex flex-col justify-between h-full border-purple-500/30">
                            <div>
                                <div class="text-xl md:text-2xl font-bold text-purple-400 poppins mb-1">${set.title}</div>
                                <div class="text-xs text-gray-400 mb-2">${set.desc}</div>
                                <div class="text-sm font-mono text-gray-300 mb-4"><i class="fa-regular fa-file-lines"></i> Quick reference</div>
                            </div>
                            <div class="flex gap-2 mt-auto">
                                <button onclick="showView('summary')" class="btn-action btn-summary w-full"><i class="fa-solid fa-eye"></i> View Summary</button>
                            </div>
                        </div>
                    `;
                    return;
                }

                // Regular MCQ sets
                const setHistory = history.filter(h => h.set === idx);
                let bestScore = -999;
                setHistory.forEach(h => { if(h.score > bestScore) bestScore = h.score; });
                
                const isResumable = savedState && savedState.isTestActive && savedState.setIndex === idx;
                const isCompleted = setHistory.length > 0;
                const questionCount = set.data.length;

                let badge = '';
                if(isResumable) badge = '<div class="badge resume">Resume Session</div>';
                else if(isCompleted) badge = '<div class="badge completed">Completed</div>';

                grid.innerHTML += `
                    <div class="set-card flex flex-col justify-between h-full">
                        ${badge}
                        <div>
                            <div class="text-xl md:text-2xl font-bold text-blue-400 poppins mb-1">${set.title}</div>
                            <div class="text-xs text-gray-400 mb-2">${set.desc}</div>
                            <div class="text-sm font-mono text-gray-300 mb-4">${questionCount} Questions</div>
                            ${isCompleted ? `<div class="text-sm font-semibold mb-3">Best Score: <span class="text-amber-400">${bestScore}</span></div>` : '<div class="h-8"></div>'}
                        </div>
                        <div class="flex gap-2 mt-auto">
                            <button onclick="startSession(${idx}, 'practice')" ${questionCount === 0 ? 'disabled' : ''} class="btn-action btn-practice touch-manipulation disabled:opacity-50"><i class="fa-solid fa-stopwatch"></i> Practice</button>
                            <button onclick="startSession(${idx}, 'study')" ${questionCount === 0 ? 'disabled' : ''} class="btn-action btn-study touch-manipulation disabled:opacity-50"><i class="fa-solid fa-book-open"></i> Study</button>
                        </div>
                    </div>
                `;
            });
        }

        async function startSession(setIdx, mode) {
            const savedState = await idbGet('progress', 'current');
            if (savedState && savedState.isTestActive && savedState.setIndex !== setIdx) {
                showDialog('Start New?', `This will override your paused ${savedState.mode} session on ${setsData[savedState.setIndex].title}.`, 'confirm', () => {
                    initNewSession(setIdx, mode);
                });
            } else if (savedState && savedState.isTestActive && savedState.setIndex === setIdx && savedState.mode === mode) {
                resumeSession(savedState);
            } else {
                initNewSession(setIdx, mode);
            }
        }

        function initNewSession(setIdx, mode) {
            currentSetIndex = setIdx;
            currentMode = mode;
            currentQIndex = 0;
            sessionState = new Array(setsData[setIdx].data.length).fill(null);
            bookmarked = new Set();
            stats = { correct: 0, wrong: 0 };
            timeRemaining = 120 * 60;
            isTestActive = true;
            
            setupQuizUI(mode);
            executeShowView('quiz');
            renderQuestion();
            updateFooterStats();
            saveProgress();
        }

        function resumeSession(state) {
            currentSetIndex = state.setIndex;
            currentMode = state.mode;
            currentQIndex = state.qIndex;
            sessionState = state.sessionState;
            bookmarked = new Set(state.bookmarked);
            stats = state.stats;
            timeRemaining = state.timeRemaining;
            isTestActive = true;

            setupQuizUI(currentMode);
            executeShowView('quiz');
            renderQuestion();
            updateFooterStats();
        }

        function setupQuizUI(mode) {
            document.getElementById('header-subtitle').innerText = setsData[currentSetIndex].title;
            const banner = document.getElementById('study-mode-banner');
            const expertBtn = document.getElementById('btn-expert-advice');
            const timerUI = document.getElementById('timer-display');
            
            if (mode === 'study') {
                banner.classList.remove('hidden');
                expertBtn.classList.remove('hidden');
                timerUI.classList.add('opacity-50');
                clearInterval(timerInterval);
                timerUI.innerHTML = `<i class="fa-solid fa-infinity"></i> <span>Study</span>`;
            } else {
                banner.classList.add('hidden');
                expertBtn.classList.add('hidden');
                timerUI.classList.remove('opacity-50');
                startTimer();
            }
        }

        async function saveProgress() {
            if (!isTestActive) return;
            const state = {
                isTestActive, setIndex: currentSetIndex, mode: currentMode,
                qIndex: currentQIndex, sessionState, bookmarked: Array.from(bookmarked),
                stats, timeRemaining, timestamp: Date.now()
            };
            await idbSet('progress', 'current', state);
        }

        async function pauseSession() {
            isTestActive = false;
            clearInterval(timerInterval);
            await saveProgress();
            renderSetCards();
        }

        function renderQuestion() {
            const set = setsData[currentSetIndex].data;
            const q = set[currentQIndex];
            const isAnswered = sessionState[currentQIndex] !== null;

            document.getElementById('progress-counter').innerText = `Q: ${currentQIndex + 1}/${set.length}`;
            document.getElementById('question-text').innerHTML = `<span class="text-blue-400 font-bold poppins text-lg">Q${currentQIndex + 1}.</span> ${q.question}`;
            document.getElementById('mark-review-checkbox').checked = bookmarked.has(currentQIndex);

            const grid = document.getElementById('options-grid');
            grid.innerHTML = '';
            
            q.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.id = `opt-${idx}`;
                const label = String.fromCharCode(65 + idx);
                btn.innerHTML = `<span class="text-blue-400 font-bold w-6 text-left shrink-0">${label}.</span> <span>${opt}</span>`;
                
                if (currentMode === 'study') {
                    btn.className = "option-btn opacity-90 cursor-default";
                    if (idx === q.correctOption) {
                        btn.classList.add('option-correct', 'opacity-100');
                    }
                } else {
                    if (!isAnswered) {
                        btn.className = "option-btn";
                        btn.onclick = () => selectOption(idx);
                    } else {
                        btn.className = "option-btn opacity-80 cursor-default";
                        if (idx === q.correctOption) btn.classList.add('option-correct', 'opacity-100');
                        else if (idx === sessionState[currentQIndex].selected && !sessionState[currentQIndex].isCorrect) {
                            btn.classList.add('option-wrong', 'opacity-100');
                        }
                    }
                }
                grid.appendChild(btn);
            });
            
            renderPalette();
            window.scrollTo(0,0);
        }

        function selectOption(idx) {
            if (currentMode === 'study' || sessionState[currentQIndex] !== null) return;
            
            playBeep(300, 'sine', 0.08);
            const q = setsData[currentSetIndex].data[currentQIndex];
            const isCorrect = (idx === q.correctOption);
            
            sessionState[currentQIndex] = { selected: idx, isCorrect: isCorrect };
            if (isCorrect) stats.correct++;
            else stats.wrong++;
            
            updateFooterStats();
            document.getElementById(`opt-${idx}`).classList.add('option-selected');
            
            setTimeout(() => {
                const selectedBtn = document.getElementById(`opt-${idx}`);
                const correctBtn = document.getElementById(`opt-${q.correctOption}`);
                selectedBtn.classList.remove('option-selected');
                
                if (isCorrect) {
                    selectedBtn.classList.add('option-correct');
                    soundCorrect();
                    showExplanationModal(true, q, idx);
                } else {
                    selectedBtn.classList.add('option-wrong');
                    if (correctBtn) correctBtn.classList.add('option-correct');
                    soundWrong();
                    showExplanationModal(false, q, idx);
                }
                saveProgress();
                renderPalette();
            }, 300);
        }

        function toggleBookmark() {
            if (bookmarked.has(currentQIndex)) bookmarked.delete(currentQIndex);
            else bookmarked.add(currentQIndex);
            renderPalette();
            saveProgress();
        }

        function updateFooterStats() {
            document.getElementById('live-correct').innerText = stats.correct;
            document.getElementById('live-wrong').innerText = stats.wrong;
            if(currentMode === 'practice') {
                const finalScore = stats.correct;
                document.getElementById('live-score-display').innerText = finalScore;
            } else {
                document.getElementById('live-score-display').innerText = '---';
            }
        }

        function nextQuestion() {
            if (currentQIndex < setsData[currentSetIndex].data.length - 1) {
                currentQIndex++;
                renderQuestion();
                saveProgress();
            } else {
                showToast("End of Set");
            }
        }

        function prevQuestion() {
            if (currentQIndex > 0) {
                currentQIndex--;
                renderQuestion();
                saveProgress();
            }
        }

        function jumpToQuestion(idx) {
            currentQIndex = idx;
            renderQuestion();
            saveProgress();
            document.getElementById('palette-panel').classList.remove('open');
        }

        let tsX = 0, tsY = 0;
        window.addEventListener('touchstart', e => {
            tsX = e.touches[0].clientX;
            tsY = e.touches[0].clientY;
        }, {passive: true});

        window.addEventListener('touchend', e => {
            if (!isTestActive) return;
            const teX = e.changedTouches[0].clientX;
            const teY = e.changedTouches[0].clientY;
            const dx = teX - tsX;
            const dy = teY - tsY;
            
            if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5) {
                if(e.target.closest('#palette-panel') || e.target.closest('#explanation-modal') || e.target.closest('.toast')) return;
                if (dx < 0) nextQuestion();
                else prevQuestion();
            }
        }, {passive: true});

        function showCurrentExplanation() {
            const q = setsData[currentSetIndex].data[currentQIndex];
            showExplanationModal(true, q, q.correctOption, true);
        }

        function showExplanationModal(isCorrect, q, selectedIdx, isStudyForce = false) {
            const modal = document.getElementById('explanation-modal');
            const title = document.getElementById('modal-title');
            const subtitle = document.getElementById('modal-subtitle');
            
            if (isStudyForce) {
                title.innerHTML = '<i class="fa-solid fa-lightbulb text-yellow-400"></i> <span class="text-yellow-400">Expert Advice</span>';
                subtitle.innerHTML = `<div class="mb-2 font-bold text-blue-300">Answer: ${q.options[q.correctOption]}</div><div class="bg-black/50 p-4 rounded-xl border border-blue-500/30 text-gray-200"><b>Explanation:</b><br><br>${q.explanation}</div>`;
            } else if (isCorrect) {
                title.innerHTML = '<i class="fa-solid fa-circle-check text-green-400"></i> <span class="text-green-400">Correct! (+1)</span>';
                subtitle.innerHTML = `<div class="bg-black/50 p-4 rounded-xl border border-green-500/30 text-gray-200"><b>Explanation:</b><br><br>${q.explanation}</div>`;
            } else {
                title.innerHTML = '<i class="fa-solid fa-circle-xmark text-red-500"></i> <span class="text-red-500">Wrong! (0)</span>';
                subtitle.innerHTML = `<div class="mb-3">Correct Answer: <span class="text-green-400 font-bold block mt-1">${q.options[q.correctOption]}</span></div><div class="bg-black/50 p-4 rounded-xl border border-red-500/30 text-gray-300"><b>Explanation:</b><br><br>${q.explanation}</div>`;
            }
            modal.classList.remove('hidden');
        }

        function closeExplanation(e) {
            if(e && e.target !== document.getElementById('explanation-modal')) return;
            document.getElementById('explanation-modal').classList.add('hidden');
        }

        function closeExplanationAndNext() {
            closeExplanation();
            nextQuestion();
        }

        function startTimer() {
            clearInterval(timerInterval);
            updateTimerUI();
            timerInterval = setInterval(() => {
                timeRemaining--;
                updateTimerUI();
                if (timeRemaining % 30 === 0) saveProgress();
                if (timeRemaining <= 0) {
                    clearInterval(timerInterval);
                    showDialog('Time Up!', 'Your 120 minutes are over. Auto-submitting the test.', 'alert', () => forceSubmit());
                }
            }, 1000);
        }

        function updateTimerUI() {
            const h = Math.floor(timeRemaining / 3600).toString().padStart(2, '0');
            const m = Math.floor((timeRemaining % 3600) / 60).toString().padStart(2, '0');
            const s = (timeRemaining % 60).toString().padStart(2, '0');
            document.getElementById('timer-display').innerHTML = `<i class="fa-regular fa-clock"></i> <span>${h}:${m}:${s}</span>`;
            if (timeRemaining <= 300) {
                document.getElementById('timer-display').classList.add('animate-pulse');
            } else {
                document.getElementById('timer-display').classList.remove('animate-pulse');
            }
        }

        function togglePalette() {
            const p = document.getElementById('palette-panel');
            p.classList.contains('open') ? p.classList.remove('open') : p.classList.add('open');
        }

        function renderPalette() {
            const grid = document.getElementById('palette-grid');
            grid.innerHTML = '';
            const setLength = setsData[currentSetIndex].data.length;
            
            for (let i = 0; i < setLength; i++) {
                const btn = document.createElement('button');
                btn.className = 'palette-btn';
                btn.textContent = i + 1;
                
                if (i === currentQIndex) btn.classList.add('current');
                if (bookmarked.has(i)) btn.classList.add('bookmarked');

                if (currentMode === 'practice') {
                    if (sessionState[i]) {
                        if (sessionState[i].isCorrect) btn.classList.add('correct');
                        else btn.classList.add('wrong');
                    }
                } else {
                    if (sessionState[i]) btn.classList.add('answered'); 
                }

                btn.onclick = () => jumpToQuestion(i);
                grid.appendChild(btn);
            }
        }

        function requestSubmit() {
            const unans = sessionState.filter(s => s === null).length;
            let msg = currentMode === 'practice' 
                ? `You have ${unans} unanswered questions. Submit and calculate score?`
                : `Exit Study Mode and return to Dashboard?`;
            
            showDialog('Submit Test', msg, 'confirm', () => forceSubmit());
        }

        async function forceSubmit() {
            isTestActive = false;
            clearInterval(timerInterval);
            document.getElementById('palette-panel').classList.remove('open');
            
            if (currentMode === 'practice') {
                const finalScore = stats.correct;
                const attempt = {
                    date: new Date().toLocaleString('en-IN', { dateStyle: 'short', timeStyle: 'short' }),
                    set: currentSetIndex,
                    correct: stats.correct,
                    wrong: stats.wrong,
                    attempted: stats.correct + stats.wrong,
                    score: finalScore
                };
                await idbAddHistory(attempt);
                showDialog('Test Submitted!', `Score: ${finalScore}\nCorrect: ${stats.correct}\nWrong: ${stats.wrong}`, 'alert', () => {
                    executeShowView('analytics');
                });
            } else {
                executeShowView('sets');
            }
            
            await idbSet('progress', 'current', null);
            renderSetCards();
        }

        async function renderAnalytics() {
            const history = await idbGetAllHistory();
            const tbody = document.getElementById('history-table-body');
            tbody.innerHTML = '';
            
            let tCorrect = 0, tWrong = 0, tAttempted = 0;
            
            history.forEach(h => {
                tCorrect += h.correct;
                tWrong += h.wrong;
                tAttempted += h.attempted;
                
                const label = setsData[h.set]?.title || `Module ${h.set + 1}`;

                tbody.innerHTML += `
                    <tr class="border-b border-white/5 hover:bg-white/5 transition">
                        <td class="p-3">${h.date}</td>
                        <td class="p-3 text-center text-blue-300 font-bold">${label}</td>
                        <td class="p-3 text-center text-green-400">${h.correct}</td>
                        <td class="p-3 text-center text-red-400">${h.wrong}</td>
                        <td class="p-3 text-center font-bold text-amber-400">${h.score}</td>
                    </tr>
                `;
            });

            if (history.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="p-5 text-center text-gray-500">No practice tests completed yet.</td></tr>';
            }

            document.getElementById('stat-attempted').innerText = tAttempted;
            document.getElementById('stat-correct').innerText = tCorrect;
            document.getElementById('stat-wrong').innerText = tWrong;
            document.getElementById('stat-accuracy').innerText = tAttempted > 0 ? Math.round((tCorrect / tAttempted) * 100) + '%' : '0%';
        }

        async function exportData() {
            const history = await idbGetAllHistory();
            const state = await idbGet('progress', 'current');
            const data = { history, state, exportDate: new Date().toISOString() };
            const blob = new Blob([JSON.stringify(data)], {type: 'application/json'});
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `CA_AITT_Backup_${new Date().getTime()}.json`;
            a.click();
            URL.revokeObjectURL(url);
            showToast('Backup Exported!');
        }

        function importData(event) {
            const file = event.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = async (e) => {
                try {
                    const data = JSON.parse(e.target.result);
                    if (data.history || data.state) {
                        await idbClearAll();
                        if (data.state) await idbSet('progress', 'current', data.state);
                        if (data.history) {
                            for(let h of data.history) await idbAddHistory(h);
                        }
                        showDialog('Success', 'Data restored successfully. Reloading view.', 'alert', () => {
                            window.location.reload();
                        });
                    } else {
                        showDialog('Error', 'Invalid Backup File format.', 'alert');
                    }
                } catch(err) {
                    showDialog('Error', 'Failed to parse JSON file.', 'alert');
                }
            };
            reader.readAsText(file);
        }

        function clearAllData() {
            showDialog('Critical Warning', 'This will delete ALL your history, progress, and scores. This cannot be undone.', 'confirm', async () => {
                await idbClearAll();
                window.location.reload();
            });
        }

        window.onload = initApp;
    </script>
</body>
</html>
