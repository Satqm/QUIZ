<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <title>CA AITT Prep - Pro Simulator</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@500;600;700&display=swap');

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
        }

        html, body {
            height: auto;
            min-height: 100%;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: radial-gradient(circle at top center, #0f172a 0%, #020617 100%);
            color: #f8fafc;
            min-height: 100vh;
            min-height: 100dvh;
            background-attachment: fixed;
            overflow-x: hidden;
            overflow-y: auto;
            padding-bottom: 0; 
            padding-top: 8px;
            overscroll-behavior-y: auto;
            -webkit-overflow-scrolling: touch;
            display: flex;
            flex-direction: column;
        }

        h1, h2, h3, .poppins {
            font-family: 'Poppins', sans-serif;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.02);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
        }

        .option-btn {
            background: linear-gradient(145deg, #1e293b 0%, #0f172a 100%);
            border: 2px solid #334155;
            transition: all 0.15s ease-out;
            cursor: pointer;
            text-align: left;
            padding: 16px 16px;
            border-radius: 14px;
            font-size: 14px;
            color: #f1f5f9;
            width: 100%;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            min-height: 52px;
            touch-action: manipulation;
        }
        .option-btn:active:not(:disabled) { transform: scale(0.97); }
        .option-btn:hover:not(:disabled) {
            background: linear-gradient(145deg, #2563eb 0%, #1d4ed8 100%);
            border-color: #60a5fa;
            transform: translateY(-1px);
        }
        .option-selected {
            background: linear-gradient(145deg, #2563eb 0%, #1d4ed8 100%) !important;
            border-color: #60a5fa !important;
        }
        .option-correct {
            background: linear-gradient(145deg, #047857 0%, #064e3b 100%) !important;
            border-color: #34d399 !important;
            box-shadow: 0 0 15px rgba(52, 211, 153, 0.35);
            opacity: 1 !important;
        }
        .option-wrong {
            background: linear-gradient(145deg, #991b1b 0%, #7f1d1d 100%) !important;
            border-color: #f87171 !important;
            box-shadow: 0 0 15px rgba(248, 113, 113, 0.35);
            opacity: 1 !important;
        }

        ::-webkit-scrollbar { width: 4px; height: 4px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(255, 255, 255, 0.15); border-radius: 10px; }
        .hide-scroll::-webkit-scrollbar { display: none; }
        .hide-scroll { -ms-overflow-style: none; scrollbar-width: none; }

        .pulse-animation { animation: pulse 1.5s infinite alternate; }
        @keyframes pulse { 0% { transform: scale(1); } 100% { transform: scale(1.03); } }

        .set-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 20px 18px;
            transition: all 0.25s ease;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }
        .set-card:hover {
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(59, 130, 246, 0.5);
            transform: translateY(-2px);
        }
        .badge {
            position: absolute; top: 10px; right: 10px;
            color: #fff; font-size: 10px; font-weight: 700;
            padding: 4px 10px; border-radius: 20px; z-index: 2;
        }
        .badge.resume { background: #d97706; animation: pulseBadge 2s infinite; }
        .badge.completed { background: #047857; }
        @keyframes pulseBadge { 0%,100% { box-shadow: 0 0 0 0 rgba(217,119,6,0.4); } 50% { box-shadow: 0 0 0 8px rgba(217,119,6,0); } }

        .btn-action {
            padding: 11px 16px; border-radius: 10px; font-weight: 600; font-size: 13px;
            border: none; cursor: pointer; transition: all 0.2s; flex: 1; min-width: 70px;
            color: white; display: flex; align-items: center; justify-content: center; gap: 6px;
        }
        .btn-action:active { transform: scale(0.95); }
        .btn-practice { background: linear-gradient(145deg, #2563eb, #1d4ed8); }
        .btn-study { background: linear-gradient(145deg, #059669, #047857); }
        .btn-summary { background: linear-gradient(145deg, #8b5cf6, #7c3aed); }  /* purple for summary */

        .palette-btn {
            width: 42px; height: 42px; border-radius: 50%; font-size: 13px; font-weight: 700;
            border: 2px solid #475569; background: #1e293b; color: #cbd5e1;
            cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: center;
            touch-action: manipulation; flex-shrink: 0; position: relative;
        }
        .palette-btn:active { transform: scale(0.9); }
        .palette-btn.answered { background: #2563eb; border-color: #60a5fa; color: #fff; }
        .palette-btn.correct { background: #047857; border-color: #34d399; color: #fff; }
        .palette-btn.wrong { background: #991b1b; border-color: #f87171; color: #fff; }
        .palette-btn.current { border-color: #fff !important; box-shadow: 0 0 0 3px rgba(255,255,255,0.25); transform: scale(1.1); }
        .palette-btn.bookmarked::after {
            content: '\f02e'; font-family: 'Font Awesome 6 Free'; font-weight: 900;
            position: absolute; top: -4px; right: -4px;
            color: #fbbf24; text-shadow: 0 1px 3px rgba(0,0,0,0.8); font-size: 12px;
        }

        .mobile-sticky-footer {
            position: fixed; bottom: 0; left: 0; right: 0; z-index: 40;
            background: rgba(15, 23, 42, 0.94); backdrop-filter: blur(16px);
            border-top: 1px solid rgba(59, 130, 246, 0.3); padding-bottom: env(safe-area-inset-bottom, 8px);
        }
        
        /* The requested Mobile Fix */
        #view-quiz { padding-bottom: 140px; }
        
        .toast {
            position: fixed; bottom: 120px; left: 50%; transform: translateX(-50%);
            background: #1e293b; border: 1px solid #3b82f6; color: #e2e8f0;
            padding: 10px 20px; border-radius: 24px; font-size: 12px; font-weight: 600;
            z-index: 200; opacity: 0; pointer-events: none; transition: all 0.3s ease;
        }
        .toast.show { opacity: 1; transform: translateX(-50%) translateY(-6px); }

        .tab-btn {
            padding: 8px 14px; border-radius: 10px; font-size: 12px; font-weight: 600;
            transition: all 0.2s; cursor: pointer; border: 1.5px solid transparent;
            color: #94a3b8; background: transparent; white-space: nowrap;
        }
        .tab-btn.active { background: #2563eb; color: #fff; border-color: #60a5fa; }
        
        #palette-panel {
            position: fixed; bottom: 90px; left: 0; right: 0;
            background: rgba(15,23,42,0.98); backdrop-filter: blur(16px);
            border-top: 2px solid rgba(59,130,246,0.4); border-radius: 24px 24px 0 0;
            z-index: 50; padding: 20px 16px 30px; max-height: 60vh;
            overflow-y: auto; display: none; box-shadow: 0 -8px 40px rgba(0,0,0,0.7);
        }
        #palette-panel.open { display: block; animation: slideUp 0.3s ease; }
        @keyframes slideUp { from { transform: translateY(100%); } to { transform: translateY(0); } }

        #custom-dialog-overlay {
            position: fixed; inset: 0; background: rgba(0,0,0,0.8);
            backdrop-filter: blur(8px); z-index: 9999; display: none;
            align-items: center; justify-content: center; padding: 20px;
        }
        #custom-dialog-overlay.active { display: flex; }
        .dialog-box {
            background: #1e293b; border: 1px solid rgba(59,130,246,0.5); border-radius: 20px;
            padding: 24px; max-width: 350px; width: 100%; text-align: center;
            box-shadow: 0 10px 40px rgba(0,0,0,0.6);
        }

        .sf-icon {
            display: flex; align-items: center; justify-content: center;
            width: 40px; height: 40px; border-radius: 50%;
            background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.2);
            color: #cbd5e1; font-size: 18px; transition: all 0.2s; text-decoration: none;
        }
        .sf-icon:hover { background: rgba(255,255,255,0.15); border-color: #60a5fa; color: #fff; transform: translateY(-2px); }
        .sf-icon.ig:hover { background: #d6249f; border-color: #d6249f; }
        .sf-icon.li:hover { background: #0077b5; border-color: #0077b5; }
        .sf-icon.yt:hover { background: #ff0000; border-color: #ff0000; }
        .sf-icon.tg:hover { background: #0088cc; border-color: #0088cc; }

        /* ─── Summary content styling ─── */
        #summary-content {
            color: #e2e8f0;
            line-height: 1.7;
        }
        #summary-content h1, #summary-content h2, #summary-content h3 {
            color: #60a5fa;
            margin-top: 1.2rem;
            margin-bottom: 0.6rem;
        }
        #summary-content h1 { font-size: 1.6rem; }
        #summary-content h2 { font-size: 1.3rem; }
        #summary-content h3 { font-size: 1.1rem; }
        #summary-content ul, #summary-content ol {
            padding-left: 1.5rem;
            margin: 0.5rem 0;
        }
        #summary-content li {
            margin-bottom: 0.25rem;
        }
        #summary-content table {
            width: 100%;
            border-collapse: collapse;
            margin: 0.8rem 0;
            font-size: 0.9rem;
            background: rgba(0,0,0,0.3);
            border-radius: 8px;
            overflow: hidden;
        }
        #summary-content th {
            background: #1e293b;
            color: #94a3b8;
            font-weight: 600;
            padding: 10px 12px;
            text-align: left;
            border-bottom: 2px solid #334155;
        }
        #summary-content td {
            padding: 10px 12px;
            border-bottom: 1px solid #1e293b;
            vertical-align: top;
        }
        #summary-content tr:hover td {
            background: rgba(255,255,255,0.02);
        }
        #summary-content .highlight {
            background: #fef9e7;
            color: #7a5d00;
            padding: 1px 6px;
            border-radius: 4px;
            font-weight: 500;
        }
        #summary-content .tag {
            display: inline-block;
            background: #1e3a5f;
            color: #93c5fd;
            font-size: 0.75rem;
            font-weight: 600;
            padding: 1px 10px;
            border-radius: 30px;
            margin-right: 4px;
        }
        #summary-content .block {
            margin: 1.2rem 0;
        }
        #summary-content .block-title {
            font-weight: 600;
            color: #93c5fd;
            margin-bottom: 0.2rem;
        }
        #summary-content .grid-2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px 20px;
            margin: 0.5rem 0;
        }
        #summary-content .grid-2 .item {
            background: rgba(0,0,0,0.25);
            padding: 8px 12px;
            border-radius: 8px;
            border-left: 3px solid #3b82f6;
        }
        #summary-content .grid-2 .item strong {
            display: block;
            color: #93c5fd;
        }
        #summary-content .grid-2 .item span {
            color: #cbd5e1;
        }
        #summary-content .chip {
            background: #1e293b;
            padding: 2px 12px;
            border-radius: 30px;
            font-size: 0.8rem;
            color: #94a3b8;
            border: 1px solid #334155;
            display: inline-block;
            margin: 2px 4px 2px 0;
        }
        @media (max-width: 640px) {
            #summary-content .grid-2 {
                grid-template-columns: 1fr;
            }
            #summary-content table {
                font-size: 0.8rem;
            }
            #summary-content th, #summary-content td {
                padding: 8px 10px;
            }
        }
    </style>
</head>
<body>

    <div id="toast" class="toast">Progress saved</div>

    <div id="custom-dialog-overlay">
        <div class="dialog-box">
            <h2 id="dialog-title" class="text-xl font-bold text-white mb-2">Notice</h2>
            <p id="dialog-message" class="text-gray-400 text-sm mb-6 leading-relaxed"></p>
            <div class="flex gap-3 justify-center" id="dialog-buttons"></div>
        </div>
    </div>

    <header class="flex flex-wrap justify-between items-center gap-2 glass-card p-2 md:p-3 rounded-xl max-w-6xl mx-auto w-full border-t-2 border-blue-500/50 sticky top-2 z-30 backdrop-blur-sm">
        <div class="flex items-center gap-2 md:gap-3">
            <button onclick="requestHome()" class="w-8 h-8 md:w-10 md:h-10 rounded-lg bg-blue-600 hover:bg-blue-500 text-white flex items-center justify-center transition shadow-lg shrink-0" title="Back to Home">
                <i class="fa-solid fa-house"></i>
            </button>
            <div class="hidden sm:flex w-9 h-9 rounded-lg bg-blue-900/40 border border-blue-500 items-center justify-center text-blue-400 font-bold poppins shrink-0 text-sm">
                <i class="fa-solid fa-file-invoice-dollar"></i>
            </div>
            <div>
                <h1 class="text-sm md:text-base font-bold text-blue-400 leading-tight">CA AITT PREP</h1>
                <p id="header-subtitle" class="text-[10px] text-gray-400">Pro Simulator</p>
            </div>
        </div>
        <div class="flex items-center gap-2 md:gap-3" id="header-controls">
            <button id="soundToggleBtn" class="w-8 h-8 rounded-full border border-white/20 text-gray-400 flex items-center justify-center transition" onclick="toggleSound()">
                <i class="fa-solid fa-volume-high" id="sound-icon"></i>
            </button>
            <div id="timer-display" class="font-mono text-sm md:text-lg font-bold text-red-400 px-3 py-1.5 bg-red-950/30 rounded-lg border border-red-500/30 flex items-center gap-2">
                <i class="fa-regular fa-clock"></i> <span>02:00:00</span>
            </div>
            <button onclick="requestSubmit()" class="px-3 py-1.5 rounded-lg bg-green-900/40 border border-green-500 text-xs font-bold text-green-300 hover:bg-green-600 hover:text-white transition flex items-center gap-1.5 touch-manipulation">
                <i class="fa-solid fa-check-double"></i> <span class="hidden sm:inline">Submit</span>
            </button>
        </div>
    </header>

    <div class="flex justify-center mt-2 max-w-6xl mx-auto w-full overflow-x-auto hide-scroll pb-1 px-1" id="main-tabs">
        <div class="glass-card p-1.5 rounded-xl flex gap-1 border border-blue-500/20 bg-black/40 w-max">
            <button class="tab-btn active" data-tab="sets" onclick="showView('sets')"><i class="fa-solid fa-layer-group"></i> Sets</button>
            <button class="tab-btn" data-tab="analytics" onclick="showView('analytics')"><i class="fa-solid fa-chart-pie"></i> Analytics</button>
            <button class="tab-btn" data-tab="summary" onclick="showView('summary')"><i class="fa-solid fa-file-lines"></i> Repeated Q. Summary</button>
            <button class="tab-btn" data-tab="rules" onclick="showView('rules')"><i class="fa-solid fa-list-check"></i> Rules</button>
        </div>
    </div>

    <main id="view-sets" class="flex flex-col max-w-6xl mx-auto w-full my-3 px-2">
        <div class="text-center mb-4">
            <h2 class="text-2xl md:text-3xl font-bold text-white poppins"><span class="text-blue-400">Select</span> Your Module</h2>
            <p class="text-gray-400 text-sm mt-1">Practice under pressure or Study with expert advice.</p>
        </div>
        
        <div id="loading-indicator" class="text-center py-10 hidden">
            <i class="fa-solid fa-circle-notch fa-spin text-4xl text-blue-500 mb-3"></i>
            <p class="text-gray-400 text-sm" id="loading-text">Fetching live resources...</p>
        </div>

        <div id="set-cards-grid" class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-5xl mx-auto w-full">
            <!-- Dynamically injected via JS -->
        </div>

        <div class="flex gap-4 justify-center items-center py-6 mt-8">
            <a href="https://www.instagram.com/" target="_blank" class="sf-icon ig" title="Instagram"><i class="fab fa-instagram"></i></a>
            <a href="https://www.linkedin.com/in/satyam-kumar5286o" target="_blank" class="sf-icon li" title="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
            <a href="https://youtube.com/@observe_with_satyam" target="_blank" class="sf-icon yt" title="YouTube"><i class="fab fa-youtube"></i></a>
            <a href="https://t.me/CA_Protracker" target="_blank" class="sf-icon tg" title="Telegram"><i class="fab fa-telegram-plane"></i></a>
        </div>
    </main>

    <main id="view-analytics" class="hidden flex-col max-w-6xl mx-auto w-full my-3 px-2">
        <div class="glass-card bg-slate-900/80 border-t-4 border-amber-500 p-4 md:p-6 rounded-2xl shadow-2xl">
            <div class="flex flex-wrap justify-between items-center mb-6 gap-3">
                <h2 class="text-xl md:text-2xl font-bold text-amber-400 poppins"><i class="fa-solid fa-chart-pie"></i> Deep Analytics</h2>
                <div class="flex gap-2">
                    <button onclick="exportData()" class="px-3 py-1.5 rounded-lg bg-blue-900/40 border border-blue-500 text-blue-300 hover:bg-blue-600 hover:text-white transition text-xs font-bold touch-manipulation"><i class="fa-solid fa-download"></i> Backup</button>
                    <label class="px-3 py-1.5 rounded-lg bg-purple-900/40 border border-purple-500 text-purple-300 hover:bg-purple-600 hover:text-white transition text-xs font-bold cursor-pointer touch-manipulation">
                        <i class="fa-solid fa-upload"></i> Restore
                        <input type="file" id="import-file" class="hidden" accept=".json" onchange="importData(event)">
                    </label>
                    <button onclick="clearAllData()" class="px-3 py-1.5 rounded-lg bg-red-900/40 border border-red-500 text-red-300 hover:bg-red-600 hover:text-white transition text-xs font-bold touch-manipulation"><i class="fa-solid fa-trash"></i> Reset</button>
                </div>
            </div>
            
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
                <div class="bg-black/40 p-3 rounded-xl border border-slate-700 text-center"><div class="text-[10px] text-gray-400 uppercase tracking-widest mb-1">Total Attempted</div><div class="text-2xl font-bold text-white" id="stat-attempted">0</div></div>
                <div class="bg-black/40 p-3 rounded-xl border border-green-900/50 text-center"><div class="text-[10px] text-green-300 uppercase tracking-widest mb-1">Total Correct</div><div class="text-2xl font-bold text-green-400" id="stat-correct">0</div></div>
                <div class="bg-black/40 p-3 rounded-xl border border-red-900/50 text-center"><div class="text-[10px] text-red-300 uppercase tracking-widest mb-1">Total Wrong</div><div class="text-2xl font-bold text-red-400" id="stat-wrong">0</div></div>
                <div class="bg-black/40 p-3 rounded-xl border border-purple-900/50 text-center"><div class="text-[10px] text-purple-300 uppercase tracking-widest mb-1">Overall Accuracy</div><div class="text-2xl font-bold text-purple-400" id="stat-accuracy">0%</div></div>
            </div>

            <h3 class="text-lg font-bold text-white mb-3">Module History</h3>
            <div class="overflow-x-auto rounded-lg border border-slate-700">
                <table class="w-full text-left border-collapse min-w-[500px]">
                    <thead>
                        <tr class="bg-blue-900/20 text-blue-300 border-b-2 border-blue-500 text-sm">
                            <th class="p-3">Date</th><th class="p-3 text-center">Module</th><th class="p-3 text-center">Correct</th><th class="p-3 text-center">Wrong</th><th class="p-3 text-center font-bold text-amber-400">Score</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-300 text-sm" id="history-table-body">
                        <!-- History injected here -->
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <!-- NEW: Summary View -->
    <main id="view-summary" class="hidden flex-col max-w-6xl mx-auto w-full my-3 px-2">
        <div class="glass-card bg-slate-900/80 border-t-4 border-purple-500 p-4 md:p-6 rounded-2xl shadow-2xl">
            <h2 class="text-xl md:text-2xl font-bold text-purple-400 poppins mb-4 flex items-center gap-2">
                <i class="fa-solid fa-file-lines"></i> Repeated Question Summary
            </h2>
            <div id="summary-content" class="text-sm text-gray-300 leading-relaxed">
                <!-- Content loaded here -->
                <div id="summary-loading" class="text-center py-10">
                    <i class="fa-solid fa-spinner fa-spin text-3xl text-purple-400"></i>
                    <p class="mt-2 text-gray-400">Loading summary...</p>
                </div>
                <div id="summary-error" class="hidden text-center py-10 text-red-400">
                    <i class="fa-solid fa-triangle-exclamation text-3xl"></i>
                    <p class="mt-2">Could not load summary. Please ensure <code>Repeated.html</code> is in the same folder.</p>
                    <button onclick="loadSummary()" class="mt-4 px-4 py-2 bg-purple-600 rounded-lg hover:bg-purple-500 transition text-white font-bold">Retry</button>
                </div>
                <div id="summary-body" class="hidden"></div>
            </div>
        </div>
    </main>

    <main id="view-rules" class="hidden flex-col max-w-6xl mx-auto w-full my-3 px-2">
        <div class="glass-card bg-slate-900/80 border-t-4 border-blue-500 p-4 md:p-6 rounded-2xl shadow-2xl text-sm text-gray-300 leading-relaxed">
            <h2 class="text-xl md:text-2xl font-bold text-blue-400 mb-4 poppins text-center">App Modes & Navigation Guide</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                <div class="bg-blue-950/30 border border-blue-800 rounded-xl p-4">
                    <h3 class="text-white font-bold mb-2 flex items-center gap-2"><i class="fa-solid fa-stopwatch text-blue-400"></i> Practice Mode</h3>
                    <p>Simulates real-world testing. Time-limited (120 minutes). Your score is evaluated upon final submission, but you get immediate visual feedback when selecting an option.</p>
                    <div class="mt-2 text-xs font-mono bg-black/40 p-2 rounded text-center"><span class="text-green-400">+1 Mark</span> | <span class="text-gray-400">0 Negative</span></div>
                </div>
                <div class="bg-emerald-950/30 border border-emerald-800 rounded-xl p-4">
                    <h3 class="text-white font-bold mb-2 flex items-center gap-2"><i class="fa-solid fa-book-open text-emerald-400"></i> Study Mode</h3>
                    <p>Designed for pure learning and revision. Correct answers are pre-highlighted. Access detailed explanations instantly via the "Expert Advice" button.</p>
